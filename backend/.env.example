PORT=3001
NODE_ENV=development

MONGO_URI_LOCAL=mongodb://localhost:27017/User_Data
USER_DB_NAME=User_Data
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=24h

GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
ALLOW_MOCK_GOOGLE=false

REDIS_URL=redis://localhost:6379
MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_DATABASE=vynedam_db
MYSQL_USER=vynedam_user
MYSQL_PASSWORD=vynedam_password

MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=vynedam-bucket

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3
